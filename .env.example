# XNOQuant API Configuration
# Copy this file to .env and fill in your session values.

# One editor per cap (recommended) — each editor must be set to the matching
# universe on the XNOQuant UI (alpha.xnoquant.io/build).
XNO_EDITOR_ID_SMALL="<editor-uuid-for-VN-SMALL-CAP>"
XNO_EDITOR_ID_MID="<editor-uuid-for-VN-MID-CAP>"
XNO_EDITOR_ID_LARGE="<editor-uuid-for-VN-LARGE-CAP>"

# Legacy single-editor fallback (used when a per-universe id is missing).
# XNO_EDITOR_ID="<paste-editor-uuid-here>"

XNO_TOKEN="<paste-bearer-token-here>"

# XNOQuant API Configuration
# Copy this file to .env and fill in your session values.

# One editor per cap (recommended) — each editor must be set to the matching
# universe on the XNOQuant UI (alpha.xnoquant.io/build).
XNO_EDITOR_ID_SMALL="<editor-uuid-for-VN-SMALL-CAP>"
XNO_EDITOR_ID_MID="<editor-uuid-for-VN-MID-CAP>"
XNO_EDITOR_ID_LARGE="<editor-uuid-for-VN-LARGE-CAP>"

# Legacy single-editor fallback (used when a per-universe id is missing).
# XNO_EDITOR_ID="<paste-editor-uuid-here>"

# Multi-editor pool for VN-MID-CAP (10 editors, round-robin submission).
# Create 10 editors on XNOQuant UI, each set to VN-MID-CAP universe,
# then paste the UUIDs here. The submit tool rotates through them automatically.
XNO_EDITOR_MID_01="<editor-uuid-01>"
XNO_EDITOR_MID_02="<editor-uuid-02>"
XNO_EDITOR_MID_03="<editor-uuid-03>"
XNO_EDITOR_MID_04="<editor-uuid-04>"
XNO_EDITOR_MID_05="<editor-uuid-05>"
XNO_EDITOR_MID_06="<editor-uuid-06>"
XNO_EDITOR_MID_07="<editor-uuid-07>"
XNO_EDITOR_MID_08="<editor-uuid-08>"
XNO_EDITOR_MID_09="<editor-uuid-09>"
XNO_EDITOR_MID_10="<editor-uuid-10>"

XNO_TOKEN="<paste-bearer-token-here>"
